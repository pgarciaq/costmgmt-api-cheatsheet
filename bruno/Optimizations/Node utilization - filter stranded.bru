meta {
  name: Node utilization - filter stranded
  type: http
  seq: 9.3
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[category]=stranded_cpu
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Filter nodes by stranded resource category.

  Uses unified filter[category] parameter. Stranded values:
  - stranded_cpu: node has stranded CPU capacity
  - stranded_memory: node has stranded memory capacity

  Comma-separate for both: filter[category]=stranded_cpu,stranded_memory
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
