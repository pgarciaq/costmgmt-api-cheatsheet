meta {
  name: Cluster quota recommendations
  type: http
  seq: 11
}

get {
  url: {{baseURL}}/recommendations/openshift/cluster-quota?filter[recommendation_type]=tighten&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Paginated list of ClusterResourceQuota recommendations.
  See "Cluster quota recommendations filters.bru" for filter[namespace], filter[risk_level], and order_by examples.
  Response rows include namespaces[] membership when populated by the operator.
}

settings {
  encodeUrl: true
  timeout: 0
}
