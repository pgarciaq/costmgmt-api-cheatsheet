meta {
  name: Container recommendations - filter cluster
  type: http
  seq: 63
}

get {
  url: {{baseURL}}/recommendations/openshift?filter[cluster]={{cluster_uuid}}&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[cluster]: {{cluster_uuid}}
  limit: 20
  offset: 0
}

docs {
  Koku-aligned bracket filter for cluster UUID (exact match) or alias (partial match).

  Aliases: filter[cluster] ↔ cluster / cluster_uuid.
}

settings {
  encodeUrl: true
  timeout: 0
}
