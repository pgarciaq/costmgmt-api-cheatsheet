meta {
  name: Filter by cluster
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/recommendations/openshift/?cluster_uuid={{cluster_uuid}}&order_by=last_reported&order_how=desc
  body: none
  auth: inherit
}

params:query {
  cluster_uuid: {{cluster_uuid}}
  order_by: last_reported
  order_how: desc
}

settings {
  encodeUrl: true
  timeout: 0
}
