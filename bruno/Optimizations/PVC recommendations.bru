meta {
  name: PVC recommendations
  type: http
  seq: 9
}

get {
  url: {{baseURL}}/recommendations/openshift/pvcs?filter[term]=medium&filter[storageclass]=gp3-csi&order_by=usage_ratio&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[term]: medium
  filter[storageclass]: gp3-csi
  order_by: usage_ratio
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  List returns one row per PVC for the selected term (default medium).
  Filters: filter[cluster], filter[project], filter[recommendation_type], filter[term] (short|medium|long or short_term|medium_term|long_term), filter[storageclass].
  Also supported: filter[tag:<key>]=<value> (see "PVC recommendations - filter tag.bru") and format=csv (see "PVC recommendations - CSV export.bru").
  Sort: order_by (usage_ratio, estimated_monthly_savings, pvc_name, capacity_bytes) + order_how.
  Each row may include mounted_by (last observed mounting pod) and vm_name (KubeVirt VM when virt-launcher).
  Use PVC recommendations detail for all terms and historical_usage.
}

settings {
  encodeUrl: true
  timeout: 0
}
