meta {
  name: GET Settings VM
  type: http
  seq: 35
}

get {
  url: {{baseURL}}/recommendations/openshift/settings/vm
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  VM sizing thresholds plus `io` (I/O profiling and pattern classification), `network` (n1 network-optimized),
  `gpu` (classification + vGPU time-slicing), and `placement` (codes 60–63).

  Example `io` defaults: high_iops_threshold=3000, sequential_threshold_bytes=65536,
  random_threshold_bytes=16384, min_iops_for_classification=100.

  Example `gpu` defaults: idle_threshold_bp=500, underutil_threshold_bp=3000, fb_saturation_mib=0,
  compute_saturation_threshold_bp=8500; gpu_timeslice_min_replicas=2, gpu_timeslice_max_replicas=16,
  gpu_timeslice_fb_safety_threshold_bp=8000, gpu_timeslice_dram_penalty_threshold_bp=5000.

  Network defaults: throughput_threshold_bps=62500000, pps_threshold=100000, drop_ratio_bp=10,
  sustained_days=7, enable_network_series=true.

  Placement defaults: enable_placement_checks=true, placement_skew_ratio=3,
  enable_shared_pvc_correlation=true, numa_node_memory_gib=64.
}

settings {
  encodeUrl: true
  timeout: 0
}
