meta {
  name: Recommendations for the 'grafana' container
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/recommendations/openshift/{{container_id}}
  body: none
  auth: inherit
}

params:query {
  : {{container_id}}
}

vars:pre-request {
  container_id: a9c994cc-8a5f-5ac6-80bb-5712d86d6dfa
}

settings {
  encodeUrl: true
  timeout: 0
}
