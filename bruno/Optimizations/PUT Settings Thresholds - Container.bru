meta {
  name: PUT Settings Thresholds - Container
  type: http
  seq: 20
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/container
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "cpu_cost_percentile": 0.65,
    "sparse_data_threshold": 2
  }
}

docs {
  PUT container threshold overrides. `sparse_data_threshold` (1–30, default 2) controls when
  notification code 77 (`SPARSE_DATA`) is emitted based on absolute `data_days`.
}

settings {
  encodeUrl: true
  timeout: 0
}
