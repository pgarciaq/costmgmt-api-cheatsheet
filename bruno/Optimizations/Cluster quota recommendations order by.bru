meta {
  name: Cluster quota recommendations order by
  type: http
  seq: 59
}

get {
  url: {{baseURL}}/recommendations/openshift/cluster-quota?order_by={{orderBy}}&order_how={{orderHow}}&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

vars:pre-request {
  orderBy: utilization
  orderHow: desc
}

docs {
  Switch order_by via vars:pre-request (Bruno pre-request vars):

  | orderBy | orderHow | Sort key |
  |---------|----------|----------|
  | cluster_quota_name | asc | CRQ object name (default sort key) |
  | utilization | desc | Max CPU/memory/storage/pods % (object-count excluded) |
  | risk_level | desc | high → medium → low → none |
  | estimated_monthly_savings | desc | tighten rows only |

  order_how: asc | desc (default desc when order_by is set)
}

settings {
  encodeUrl: true
  timeout: 0
}
