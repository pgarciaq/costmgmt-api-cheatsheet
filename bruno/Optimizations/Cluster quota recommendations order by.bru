meta {
  name: Cluster quota recommendations order by
  type: http
  seq: 59
}

get {
  url: {{baseURL}}/recommendations/openshift/cluster-quota?order_by=cluster_quota_name&order_how=asc&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  All four order_by values (repeat request with each order_by):

  1. order_by=cluster_quota_name&order_how=asc  (default sort key)
  2. order_by=utilization&order_how=desc       (max CPU/memory/storage/pods %)
  3. order_by=risk_level&order_how=desc         (high → medium → low → none)
  4. order_by=estimated_monthly_savings&order_how=desc  (tighten rows only)

  order_how=asc | desc (default desc when order_by is set)
}

settings {
  encodeUrl: true
  timeout: 0
}
