meta {
  name: Fleet savings summary filter cluster
  type: http
  seq: 15
}

get {
  url: {{baseURL}}/recommendations/openshift/savings-summary?filter[cluster]=my-cluster-id
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Fleet savings filtered to a specific cluster UUID. Useful when group_by[tag:*] or group_by[idle_state] is active to scope results.
}

settings {
  encodeUrl: true
  timeout: 0
}
