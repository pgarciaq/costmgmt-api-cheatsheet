meta {
  name: Fleet savings summary filter cluster
  type: http
  seq: 15
}

get {
  url: {{baseURL}}/recommendations/openshift/savings-summary?group_by[idle_state]=*&filter[cluster]=my-cluster-id
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Fleet savings filtered to a specific cluster UUID.

  `filter[cluster]` only takes effect when a `group_by` parameter is present (for example `group_by[idle_state]=*` or `group_by[tag:environment]=*`). Without `group_by`, the cluster filter is ignored and the response reflects the full fleet rollup.
}

settings {
  encodeUrl: true
  timeout: 0
}
