meta {
  name: Namespace recommendations
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces
  body: none
  auth: inherit
}

docs {
  Namespace-level CPU/memory quota recommendations.

  When business hours is enabled (`ROS_BUSINESS_HOURS_ENABLED`) and reship is complete,
  each engine may include a `business_hours` block (same shape as container recommendations)
  alongside the default all-hours `config`.
}

settings {
  encodeUrl: true
  timeout: 0
}
