meta {
  name: Namespace recommendations
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces
  body: none
  auth: inherit
}

docs {
  Namespace-level CPU/memory quota recommendations.

  List stays all-hours: nested `business_hours` is omitted (including unfiltered
  requests without filter[term]/filter[engine]). Fetch GET .../namespaces/{id}
  for the Peak hours nest when ROS_BUSINESS_HOURS_ENABLED and reship is complete.
}

settings {
  encodeUrl: true
  timeout: 0
}
