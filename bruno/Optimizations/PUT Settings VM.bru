meta {
  name: PUT Settings VM
  type: http
  seq: 36
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/vm
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "thresholds": {
      "cpu_margin_min": 1.18
    },
    "io": {
      "sequential_threshold_bytes": 131072,
      "random_threshold_bytes": 8192,
      "min_iops_for_classification": 200
    },
    "network": {
      "throughput_threshold_bps": 100000000,
      "pps_threshold": 150000,
      "drop_ratio_bp": 10,
      "sustained_days": 5,
      "enable_network_series": true
    },
    "gpu": {
      "idle_threshold_bp": 300,
      "underutil_threshold_bp": 2500,
      "fb_saturation_mib": 0,
      "compute_saturation_threshold_bp": 9000,
      "gpu_timeslice_min_replicas": 2,
      "gpu_timeslice_max_replicas": 8,
      "gpu_timeslice_fb_safety_threshold_bp": 7500,
      "gpu_timeslice_dram_penalty_threshold_bp": 5000
    },
    "placement": {
      "placement_skew_ratio": 4,
      "numa_node_memory_gib": 48
    }
  }
}

docs {
  Partial PUT for VM settings. `io` thresholds drive `io_profile.pattern` (sequential/random/mixed/low-io)
  and notifications 58/59. `gpu` classification thresholds drive VM GPU notifications 50–54;
  time-slicing fields control codes 56–57. `placement` controls redundancy/NUMA checks (60–63).
}

settings {
  encodeUrl: true
  timeout: 0
}
