meta {
  name: Cluster quota recommendations group by cluster
  type: http
  seq: 12
}

get {
  url: {{baseURL}}/recommendations/openshift/cluster-quota?group_by[cluster]=*&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Aggregate ClusterResourceQuota recommendations per cluster.
  Each row includes cluster_uuid, count (CRQ rows in cluster), and summed
  estimated_savings and capacity_freed when present.
}

settings {
  encodeUrl: true
  timeout: 0
}
