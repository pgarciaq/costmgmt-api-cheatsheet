meta {
  name: Node utilization - filter category multi
  type: http
  seq: 8.3
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[category]=idle,overcommitted
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Comma-separated category filter returns nodes matching ANY of the specified categories.
  Example: filter[category]=idle,overcommitted includes both idle and overcommitted nodes.

  Valid node categories: idle, overcommitted, stranded_cpu, stranded_memory, underutilized, optimized.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
