meta {
  name: Node utilization - filter term short
  type: http
  seq: 9.1
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes
  body: none
  auth: inherit
}

params:query {
  limit: 20
  offset: 0
  filter[term]: short
  filter[engine]: cost
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  List nodes scoped to the short recommendation term (`filter[term]=short` → `short_term` in `recommendation_terms`).
  Pair with "Node utilization - filter term long" and the default medium examples in other node requests.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
