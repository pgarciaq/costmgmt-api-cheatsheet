meta {
  name: VM recommendations detail
  type: http
  seq: 32
}

get {
  url: {{baseURL}}/recommendations/openshift/vm/detail?cluster_uuid=CLUSTER_UUID&vm_name=my-vm&namespace=my-namespace&term=medium_term&engine=cost
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Detail includes `io_profile.pattern` (sequential, random, mixed, low-io, or empty),
  `metadata.is_network_bound`, `metadata.is_redundant_placement`, `metadata.has_shared_storage`,
  `metadata.numa_oversized`, GPU time-slicing fields (`gpu_timeslice_confidence`, `gpu_timeslice_rationale`, `recommended_vgpu_profile`),
  and VM notifications (e.g. 55–59 network/GPU/I/O, 60–63 placement/NUMA).
  Visual Insights: `daily_digests` (all-hours) and optional sibling `daily_digests_business_hours`
  (same row shape; omitted when empty).
}

settings {
  encodeUrl: true
  timeout: 0
}
