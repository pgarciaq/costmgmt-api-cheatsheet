meta {
  name: VM recommendations detail
  type: http
  seq: 32
}

get {
  url: {{baseURL}}/recommendations/openshift/vm/detail?cluster_uuid=CLUSTER_UUID&vm_name=my-vm&namespace=my-namespace&term=medium_term&engine=cost
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Detail includes `metadata.is_network_bound`, GPU time-slicing fields (`gpu_timeslice_confidence`, `gpu_timeslice_rationale`, `recommended_vgpu_profile`),
  and VM notifications (e.g. 55 network-saturated, 56 vGPU profile, 57 unsafe FB for time-slice).
}

settings {
  encodeUrl: true
  timeout: 0
}
