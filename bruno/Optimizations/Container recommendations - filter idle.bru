meta {
  name: Container recommendations - filter idle
  type: http
  seq: 63
}

get {
  url: {{baseURL}}/recommendations/openshift?filter[category]=idle&order_by=last_reported&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[category]: idle
  order_by: last_reported
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  filter[category] — unified classification filter for containers/namespaces.
  Valid values: idle, zombie, undersized, oversized, optimized.

  Idle rows expose estimated_monthly_waste and idle_recommendation; rightsizing
  estimated_monthly_savings is omitted when category is idle or zombie.

  Replaces the former filter[idle_state] parameter.
}

settings {
  encodeUrl: true
  timeout: 0
}
