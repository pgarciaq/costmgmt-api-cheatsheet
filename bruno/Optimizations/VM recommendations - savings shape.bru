meta {
  name: VM recommendations - savings shape
  type: http
  seq: 98
}

get {
  url: {{baseURL}}/recommendations/openshift/vm?limit=5&order_by=last_recommended_at&order_how=desc
  body: none
  auth: inherit
}

params:query {
  limit: 5
  order_by: last_recommended_at
  order_how: desc
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  VM list rows may include `savings` — structured currency object or null when estimates are disabled:

    "savings": { "value": "42.500000", "units": "USD" }

  - value — decimal string (monthly rightsizing delta for the row term/engine)
  - units — ISO 4217 currency code
  - null — ROS_SAVINGS_ESTIMATES_ENABLED=false or no Masu rates at ingestion

  Negative values mean additional monthly cost (upsize recommendation).
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}

tests {
  test("savings is structured object or null", function() {
    if (res.body.data && res.body.data.length > 0) {
      var savings = res.body.data[0].savings;
      if (savings !== null && savings !== undefined) {
        expect(savings).to.be.an('object');
        expect(Number(savings.value)).to.not.be.NaN;
        expect(savings.units).to.be.a('string');
      }
    }
  });
}
