meta {
  name: GPU time-slicing recommendations - order by
  type: http
  seq: 22
}

get {
  url: {{baseURL}}/recommendations/openshift/gpu/timeslicing?order_by=node_name&order_how=asc&limit=50&offset=0
  body: none
  auth: inherit
}

params:query {
  order_by: node_name
  order_how: asc
  limit: 50
  offset: 0
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Sort GPU time-slicing list by node name ascending.

  DB-backed `order_by` values: node_name, cluster_uuid, gpu_model (SQL ORDER BY on gpu_container_digests triples).
  `recommended_replicas`, `confidence`, and `total_node_savings` return HTTP 400 (post-aggregate fields).
  `order_how`: asc or desc (default desc).
}

settings {
  encodeUrl: true
  timeout: 0
}
