meta {
  name: PUT Settings Thresholds - GPU
  type: http
  seq: 26
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/gpu
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "idle_threshold": 0.03
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
