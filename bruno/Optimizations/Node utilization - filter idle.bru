meta {
  name: Node utilization - filter idle
  type: http
  seq: 8.1
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[category]=idle
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Nodes classified as idle (low CPU/memory utilization vs allocatable, moderate pod count).

  Uses unified filter[category] parameter. Valid node categories:
  idle, overcommitted, stranded_cpu, stranded_memory, underutilized, optimized.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
