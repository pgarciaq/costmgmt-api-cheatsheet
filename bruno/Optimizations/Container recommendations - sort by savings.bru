meta {
  name: Container recommendations - sort by variation
  type: http
  seq: 64
}

get {
  url: {{baseURL}}/recommendations/openshift?order_by=cpu_variation_medium_cost&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  order_by: cpu_variation_medium_cost
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  Sort container list by medium-term cost-engine CPU variation (descending).

  Valid order_by keys (ContainerAllowedOrderBy):
    cluster, project, workload_type, workload, container, last_reported,
    cpu_request_current, memory_request_current,
    cpu_variation_short_cost, cpu_variation_short_performance,
    cpu_variation_medium_cost, cpu_variation_medium_performance,
    cpu_variation_long_cost, cpu_variation_long_performance,
    memory_variation_short_cost, memory_variation_short_performance,
    memory_variation_medium_cost, memory_variation_medium_performance,
    memory_variation_long_cost, memory_variation_long_performance.

  Bracket form: order_by[cpu_variation_medium_cost]=desc.
  Variation values are percent of current CPU or memory request.
}

settings {
  encodeUrl: true
  timeout: 0
}
