meta {
  name: Container recommendations - sort by savings
  type: http
  seq: 64
}

get {
  url: {{baseURL}}/recommendations/openshift?order_by=estimated_monthly_savings&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  order_by: estimated_monthly_savings
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  Sort container list by medium-term cost-engine monthly savings (descending).

  Bracket form is also accepted: order_by[estimated_monthly_savings]=desc.
  Requires persisted savings on recommendation rows (Masu cost model rates during ingestion).
}

settings {
  encodeUrl: true
  timeout: 0
}
