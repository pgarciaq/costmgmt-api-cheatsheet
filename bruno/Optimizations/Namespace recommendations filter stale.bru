meta {
  name: Namespace recommendations filter stale
  type: http
  seq: 12
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?filter[stale]=only&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[stale]: only
  limit: 20
  offset: 0
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  filter[stale] — only rows whose cluster has not reported within ROS_STALENESS_THRESHOLD_HOURS (default 48).
  Other values: false (default, exclude stale), true (include stale and fresh).
}

settings {
  encodeUrl: true
  timeout: 0
}
