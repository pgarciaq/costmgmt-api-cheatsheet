meta {
  name: Container recommendations - filter workload type
  type: http
  seq: 69
}

get {
  url: {{baseURL}}/recommendations/openshift?filter[workload_type]=deployment&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[workload_type]: deployment
  limit: 20
  offset: 0
}

docs {
  filter[workload_type] — exact match on the workload controller kind (lowercase).

  Any valid Kubernetes workload kind is accepted (no fixed allowlist).
  Common values: daemonset, deployment, deploymentconfig, replicaset,
    replicationcontroller, statefulset, domain, kafkanodepool, etc.

  Comma-separated values are ORed: filter[workload_type]=deployment,statefulset

  Legacy flat form ?workload_type=deployment is also accepted.
  Invalid formats (empty, special characters) return 400.
}

settings {
  encodeUrl: true
  timeout: 0
}
