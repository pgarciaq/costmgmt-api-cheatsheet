meta {
  name: PUT Settings Thresholds - Node
  type: http
  seq: 23
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/node
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "underutil_threshold": 0.35,
    "zombie_cpu_p95_mc": 200,
    "zombie_max_pods": 5,
    "idle_cpu_util_pct": 10,
    "idle_mem_util_pct": 10,
    "idle_max_pods": 10,
    "pod_headroom_consolidation_gate": 0.15,
    "pod_headroom_notification_threshold": 0.10
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
}
