meta {
  name: History
  type: http
  seq: 14
}

get {
  url: {{baseURL}}/recommendations/openshift/history?cluster={{clusterUuid}}&container=grafana&filter[engine]=cost&term=medium&limit=10
  body: none
  auth: inherit
}

params:query {
  cluster: {{clusterUuid}}
  container: grafana
  filter[engine]: cost
  term: medium
  limit: 10
}

docs {
  Container recommendation snapshot history (fleet-wide).

  Optional filters: cluster, project, workload, container, term (short|medium|long),
  filter[engine] (cost|performance), start_date, end_date.

  Legacy flat ?engine=cost is also accepted (same behavior as filter[engine]).

  Each row includes recorded_at, namespace, container_name, term, engine,
  rec_cpu_request_millicores, rec_memory_request_kib, and estimated_monthly_savings.
}

settings {
  encodeUrl: true
  timeout: 0
}
