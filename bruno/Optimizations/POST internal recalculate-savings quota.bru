meta {
  name: POST internal recalculate-savings (quota only)
  type: http
  seq: 51
}

post {
  url: {{baseURL}}/internal/recalculate-savings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceAccountToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "org_id": "1234567",
    "cluster_uuid": "02059694-68ab-4d58-8809-de1e91f1d0e5",
    "recommendation_types": ["quota", "cluster-quota"]
  }
}

docs {
  Recalculate quota and cluster-quota tighten savings only (no classification re-run).

  Requires ROS_SAVINGS_ESTIMATES_ENABLED and ROS_SAVINGS_RECALCULATION_ENABLED.
}

vars:pre-request {
  serviceAccountToken: 
}

settings {
  encodeUrl: true
  timeout: 0
}
