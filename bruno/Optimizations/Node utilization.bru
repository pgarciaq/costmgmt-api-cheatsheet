meta {
  name: Node CPU/memory utilization
  type: http
  seq: 8
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes
  body: none
  auth: inherit
}

params:query {
  limit: 10
  offset: 0
  filter[term]: medium
  filter[engine]: cost
  ~filter[cluster]: 
  ~filter[node]: 
  ~filter[is_underutilized]: 
  ~filter[is_overcommitted]: 
  ~filter[idle_state]: zombie
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Canonical path for node CPU and memory utilization recommendations (deprecated alias: `/nodes/utilization`).

  Filters: filter[term], filter[engine], filter[stranded_resource], filter[instance_type],
  filter[machineset_name], filter[idle_state], filter[is_underutilized], filter[is_overcommitted].

  Response: pod_capacity, pod_scheduling_headroom, machineset_name, suggested_instance_type,
  instance_type_reason; nested recommendation_terms with cost and performance engines.

  Fleet consolidation groups by instance_type when present, else similar allocatable capacity.
}

settings {
  encodeUrl: true
  timeout: 0
}
