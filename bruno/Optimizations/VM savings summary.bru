meta {
  name: VM savings summary
  type: http
  seq: 15
}

get {
  url: {{baseURL}}/recommendations/openshift/savings-summary?engine=cost&term=medium
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

params:query {
  engine: cost
  term: medium
}

docs {
  Fleet savings rollup. by_plugin.vm requires ROS_SAVINGS_ESTIMATES_ENABLED and
  KOKU_MASU_URL at VM ingestion time for non-zero totals.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.by_plugin: isDefined
}

tests {
  test("by_plugin includes vm as MoneyAmount", function() {
    expect(res.body.by_plugin.vm).to.be.an("object");
    expect(res.body.by_plugin.vm.value).to.be.a("string");
    expect(res.body.by_plugin.vm.units).to.be.a("string");
  });
}
