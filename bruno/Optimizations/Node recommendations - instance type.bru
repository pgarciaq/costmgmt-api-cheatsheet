meta {
  name: Node recommendations - instance type
  type: http
  seq: 21
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[instance_type]=m5.xlarge&limit=10
  body: none
  auth: inherit
}

params:query {
  filter[instance_type]: m5.xlarge
  limit: 10
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Instance type on list/detail node objects:

  - instance_type — operator-reported type (e.g. m5.2xlarge); may be empty
  - suggested_instance_type — fleet hint when a better-matched type exists in the cluster (response field, not a filter)
  - instance_type_reason — human-readable explanation when suggested_instance_type is set

  List filter: filter[instance_type]=<value> returns only nodes with that instance_type.
  Use a value observed in your cluster, or filter[category]=stranded_cpu to surface suggestions more often.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
