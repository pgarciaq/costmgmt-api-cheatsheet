meta {
  name: Snapshot staleness - filter project
  type: http
  seq: 15
}

get {
  url: {{baseURL}}/recommendations/openshift/snapshots?filter[project]=my-namespace&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

params:query {
  filter[project]: my-namespace
  limit: 20
  offset: 0
}

docs {
  filter[project] — namespace (project) name; RBAC-scoped.
  Legacy alias: filter[namespace] (flat query param).
  Combine with filter[cluster], filter[recommendation_type], limit, offset.
}

settings {
  encodeUrl: true
  timeout: 0
}
