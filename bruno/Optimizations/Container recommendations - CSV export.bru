meta {
  name: Container recommendations - CSV export
  type: http
  seq: 65
}

get {
  url: {{baseURL}}/recommendations/openshift?format=csv&limit=100&offset=0&order_by=last_reported&order_how=desc
  body: none
  auth: inherit
}

headers {
  Accept: text/csv
}

params:query {
  format: csv
  limit: 100
  offset: 0
  order_by: last_reported
  order_how: desc
}

docs {
  CSV export for container recommendations.

  - format=csv when Accept is missing or ambiguous (max 1000 records / 6000 CSV rows).
  - Prefer Accept: text/csv for explicit content negotiation.
  - Use offset for pagination across large fleets.
}

settings {
  encodeUrl: true
  timeout: 0
}
