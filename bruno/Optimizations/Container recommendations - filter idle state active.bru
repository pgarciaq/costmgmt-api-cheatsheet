meta {
  name: Container recommendations - filter category optimized
  type: http
  seq: 65
}

get {
  url: {{baseURL}}/recommendations/openshift?filter[category]=undersized,oversized,optimized&order_by=last_reported&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[category]: undersized,oversized,optimized
  order_by: last_reported
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  filter[category]=undersized,oversized,optimized — workloads with active usage that
  receive right-sizing recommendations.

  Active containers (non-idle, non-zombie) are now represented by these category values.
  They may include estimated_monthly_savings when Masu cost model rates are available.

  Valid container/namespace categories: idle, zombie, undersized, oversized, optimized.
  Comma-separated values are ORed.
}

settings {
  encodeUrl: true
  timeout: 0
}
