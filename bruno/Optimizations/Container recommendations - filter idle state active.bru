meta {
  name: Container recommendations - filter idle state active
  type: http
  seq: 65
}

get {
  url: {{baseURL}}/recommendations/openshift?filter[idle_state]=active&order_by=last_reported&order_how=desc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[idle_state]: active
  order_by: last_reported
  order_how: desc
  limit: 20
  offset: 0
}

docs {
  filter[idle_state]=active — workloads with normal usage above idle thresholds.

  Active containers receive full right-sizing recommendations and may include
  estimated_monthly_savings when Masu cost model rates are available.
  Rightsizing savings are omitted when idle_state is idle or zombie.

  Other values: idle (low usage), zombie (zero usage / abandoned).
}

settings {
  encodeUrl: true
  timeout: 0
}
