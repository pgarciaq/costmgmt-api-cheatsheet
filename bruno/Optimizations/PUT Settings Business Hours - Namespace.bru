meta {
  name: PUT Settings Business Hours - Namespace
  type: http
  seq: 83
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/business-hours/clusters/{{cluster_uuid}}/namespaces/{{project}}
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "timezone": "America/New_York",
    "schedule": {
      "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
      "start_time": "08:00",
      "end_time": "17:00"
    },
    "off_hours_weight": 0.0,
    "enabled": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
