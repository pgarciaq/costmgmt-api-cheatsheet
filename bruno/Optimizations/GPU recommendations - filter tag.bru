meta {
  name: GPU recommendations - filter tag
  type: http
  seq: 23
}

get {
  url: {{baseURL}}/recommendations/openshift/gpu/mig?filter[tag:environment]=production&limit=20
  body: none
  auth: inherit
}

params:query {
  filter[tag:environment]: production
  limit: 20
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Tag filter on GPU MIG recommendations (requires ROS_TAGS_ENABLED=true).

  Workloads are included when their namespace matches the tag filter.
  Use gpu/timeslicing for time-slicing recommendations with the same filter syntax.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
