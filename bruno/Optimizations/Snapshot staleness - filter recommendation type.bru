meta {
  name: Snapshot staleness - filter recommendation type
  type: http
  seq: 13
}

get {
  url: {{baseURL}}/recommendations/openshift/snapshots?filter[recommendation_type]=orphaned&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

params:query {
  filter[recommendation_type]: orphaned
  limit: 20
  offset: 0
}

docs {
  filter[recommendation_type] — orphaned, never_restored, redundant, stale, managed, or active.
  Legacy alias: recommendation_type (flat query param).
  Example: change the query value to redundant, stale, or managed to exercise other classifications.
}

settings {
  encodeUrl: true
  timeout: 0
}
