meta {
  name: Node utilization - filter overcommitted
  type: http
  seq: 9.7
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[category]=overcommitted
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Filter nodes classified as overcommitted (resource requests exceed allocatable capacity).

  Uses unified filter[category] parameter. Valid node categories:
  idle, overcommitted, stranded_cpu, stranded_memory, underutilized, optimized.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
