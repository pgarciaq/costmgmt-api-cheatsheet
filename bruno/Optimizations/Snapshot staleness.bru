meta {
  name: Snapshot staleness
  type: http
  seq: 10
}

get {
  url: {{baseURL}}/recommendations/openshift/snapshots?limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

params:query {
  limit: 20
  offset: 0
}

docs {
  VolumeSnapshot staleness list. Default sort: age_days descending.
  Use filter[cluster], filter[project], filter[recommendation_type] on dedicated requests.
  Keyset pagination: follow meta.next_cursor as ?after= on subsequent requests.
  estimated_monthly_cost is MoneyAmount: {"value": "12.50", "units": "USD"}.
  CSV export: see "Snapshot staleness - CSV export" request (format=csv).
}

settings {
  encodeUrl: true
  timeout: 0
}
