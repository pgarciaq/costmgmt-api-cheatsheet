meta {
  name: PUT Settings Business Hours
  type: http
  seq: 77
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/business-hours
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "timezone": "America/New_York",
    "schedule": {
      "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
      "start_time": "08:00",
      "end_time": "17:00"
    },
    "off_hours_weight": 0.0,
    "enabled": true
  }
}

docs {
  PUT returns 202 Accepted and triggers asynchronous digest reship (reship_ros).

  Overnight windows are allowed: schedule.end_time may be before schedule.start_time
  (for example 22:00–06:00). The window is half-open [start, end) on the local wall
  clock in the IANA timezone (not elapsed duration; DST may skip or repeat an hour).
  Samples after midnight belong to the previous calendar day's shift. Equal start and
  end times return 400. 08:00–17:00 in this body is a typical office example, not the
  only legal window. PUT may include a non-fatal wrap warning.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 202
}
