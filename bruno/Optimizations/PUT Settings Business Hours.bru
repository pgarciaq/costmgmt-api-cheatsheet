meta {
  name: PUT Settings Business Hours
  type: http
  seq: 77
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/business-hours
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "timezone": "America/New_York",
    "schedule": {
      "days": ["monday", "tuesday", "wednesday", "thursday", "friday"],
      "start_time": "08:00",
      "end_time": "17:00"
    },
    "off_hours_weight": 0.0,
    "enabled": true
  }
}

docs {
  PUT returns 202 Accepted and triggers asynchronous digest reship (reship_ros).

  Overnight windows are rejected: schedule.end_time must be after schedule.start_time (same calendar day), otherwise 400.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 202
}
