meta {
  name: PUT Settings Thresholds - Cluster quota
  type: http
  seq: 59
}

put {
  url: {{baseURL}}/recommendations/openshift/settings/cluster-quota
  body: json
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
  content-type: application/json
}

body:json {
  {
    "headroom_percent": 15,
    "high_risk_threshold_percent": 85,
    "medium_risk_threshold_percent": 65
  }
}

docs {
  Override cluster-quota recommendation thresholds (percent values).
  Locked fields from GET are ignored on PUT. Use DELETE to restore defaults.
}

settings {
  encodeUrl: true
  timeout: 0
}
