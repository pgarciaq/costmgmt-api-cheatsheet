meta {
  name: Namespace recommendations filter category
  type: http
  seq: 73
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?filter[category]=idle,zombie&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[category]: idle,zombie
  limit: 20
  offset: 0
}

docs {
  filter[category]=idle,zombie — namespaces where aggregated category is idle or zombie.

  A namespace is zombie when every container and GPU in it is zombie; idle when all
  workloads are non-active but at least one is idle (a mix of idle and zombie counts as idle).

  Comma-separated values are ORed. Replaces the former filter[idle_state] parameter.

  Valid container/namespace categories: idle, zombie, undersized, oversized, optimized.
}

settings {
  encodeUrl: true
  timeout: 0
}
