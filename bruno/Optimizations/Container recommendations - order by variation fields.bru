meta {
  name: Container recommendations - order by variation fields
  type: http
  seq: 71
}

get {
  url: {{baseURL}}/recommendations/openshift?order_by=cpu_variation_medium_cost&order_how=desc&limit=20
  body: none
  auth: inherit
}

params:query {
  order_by: cpu_variation_medium_cost
  order_how: desc
  limit: 20
}

docs {
  Sort container list by any OpenAPI order_by key (flat order_by + order_how or bracket form).

  Non-variation example:
    ?order_by=last_reported&order_how=desc

  Variation examples (percent change vs current request):
    ?order_by=cpu_variation_medium_cost&order_how=desc
    ?order_by=memory_variation_long_performance&order_how=asc
    ?order_by=cpu_variation_short_cost&order_how=desc

  Bracket form also accepted:
    ?order_by[memory_variation_medium_cost]=desc

  Full order_by enum (OpenAPI GET /recommendations/openshift):
    1. cluster
    2. project
    3. workload_type
    4. workload
    5. container
    6. last_reported
    7. cpu_request_current
    8. memory_request_current
    9. cpu_variation_short_cost
    10. cpu_variation_short_performance
    11. cpu_variation_medium_cost
    12. cpu_variation_medium_performance
    13. cpu_variation_long_cost
    14. cpu_variation_long_performance
    15. memory_variation_short_cost
    16. memory_variation_short_performance
    17. memory_variation_medium_cost
    18. memory_variation_medium_performance
    19. memory_variation_long_cost
    20. memory_variation_long_performance
}

settings {
  encodeUrl: true
  timeout: 0
}
