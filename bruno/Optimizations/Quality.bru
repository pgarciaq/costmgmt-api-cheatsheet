meta {
  name: Quality
  type: http
  seq: 15
}

get {
  url: {{baseURL}}/recommendations/openshift/quality?cluster={{clusterUuid}}&container=grafana&order_by=stability&order_how=desc&limit=10
  body: none
  auth: inherit
}

params:query {
  cluster: {{clusterUuid}}
  container: grafana
  order_by: stability
  order_how: desc
  limit: 10
}

docs {
  Recommendation quality metrics (stability, adoption, OOM-after-rec).

  Optional filters: cluster, project, workload, container, filter[engine]=cost|performance.
  Sort: order_by=stability|adoption|oom_events|recommendation_age|measured_at with order_how=asc|desc.

  Each row includes measured_at, namespace, workload, container_name, engine,
  stability_pct (0.0–1.0), adoption_detected (boolean), oom_events_after_rec,
  and recommendation_age_hours when populated.
}

settings {
  encodeUrl: true
  timeout: 0
}
