meta {
  name: Namespace recommendations - filter engine performance
  type: http
  seq: 69
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?filter[engine]=performance&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  filter[engine]: performance
  limit: 20
  offset: 0
}

docs {
  filter[engine]=performance — return only the performance engine under each recommendation term.

  Also accepted: filter[engine]=cost, or legacy flat ?engine=performance.

  When a list filter is set, the non-selected engine is omitted from
  recommendation_terms.<term>.recommendation_engines on each namespace item.
  When omitted, both cost and performance are returned.
}

settings {
  encodeUrl: true
  timeout: 0
}
