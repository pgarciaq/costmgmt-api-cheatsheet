meta {
  name: Snapshot recommendations - holding cost
  type: http
  seq: 99
}

get {
  url: {{baseURL}}/recommendations/openshift/snapshots?limit=5&order_by=age_days&order_how=desc
  body: none
  auth: inherit
}

params:query {
  limit: 5
  order_by: age_days
  order_how: desc
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Snapshot list rows include recoverable monthly holding cost as `estimated_monthly_cost`
  (`MoneyAmount`: {"value": "12.50", "units": "USD"}) when savings estimates are enabled.

  Formula: restore_size_gib × cost_per_gib_month (default $0.05/GiB until billing-accurate rates ship).
  Persisted as estimated_cost_cents (BIGINT) in snapshot_recommendation_sets.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}

tests {
  test("estimated_monthly_cost has MoneyAmount shape when present", function() {
    if (res.body.data && res.body.data.length > 0) {
      var cost = res.body.data[0].estimated_monthly_cost;
      if (cost !== null && cost !== undefined) {
        expect(cost).to.have.property("value");
        expect(cost).to.have.property("units");
        expect(Number(cost.value)).to.not.be.NaN;
      }
    }
  });
}
