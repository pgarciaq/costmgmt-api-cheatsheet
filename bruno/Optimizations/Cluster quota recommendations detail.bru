meta {
  name: Cluster quota recommendations detail
  type: http
  seq: 57
}

get {
  url: {{baseURL}}/recommendations/openshift/cluster-quota/detail?cluster_uuid=CLUSTER_UUID&cluster_quota_name=team-payments-quota
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Required query params: cluster_uuid (cluster UUID), cluster_quota_name (CRQ object name).
  Returns one CRQ recommendation (not wrapped in data[]) with quota_hard/used/recommended,
  utilization, notifications (codes 70-73), and history[] per resource.
}

settings {
  encodeUrl: true
  timeout: 0
}
