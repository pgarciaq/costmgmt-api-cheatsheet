meta {
  name: Namespace recommendations - order by
  type: http
  seq: 10
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?order_by=namespace&order_how=asc&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  order_by: namespace
  order_how: asc
  limit: 20
  offset: 0
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Allowed order_by values include `namespace`, `cluster`, `last_reported`, and variation columns.
}

settings {
  encodeUrl: true
  timeout: 0
}
