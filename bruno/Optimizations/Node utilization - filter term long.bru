meta {
  name: Node utilization - filter term long
  type: http
  seq: 9.2
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes
  body: none
  auth: inherit
}

params:query {
  limit: 20
  offset: 0
  filter[term]: long
  filter[engine]: cost
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  List nodes scoped to the long recommendation term (`filter[term]=long` → `long_term` in `recommendation_terms`).
  Valid term values: `short`, `medium`, `long` (aliases `short_term`, `medium_term`, `long_term` also accepted).
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
