meta {
  name: Node utilization - filters
  type: http
  seq: 9
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes
  body: none
  auth: inherit
}

params:query {
  limit: 20
  offset: 0
  filter[term]: medium
  filter[engine]: cost
  ~filter[term]: short
  ~filter[term]: long
  ~filter[cluster]: 
  ~filter[node]: 
  ~filter[category]: idle
  ~filter[category]: overcommitted
  ~filter[category]: stranded_cpu,stranded_memory
  ~filter[category]: underutilized
  ~filter[instance_type]: m5.2xlarge
  ~filter[machineset_name]: worker
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Canonical list endpoint with bracket filters (preferred over flat `?term=` / `?engine=`).

  filter[term]: `short`, `medium`, or `long` (see also "Node utilization - filter term short/long" requests).

  filter[category]: unified classification filter replacing the former filter[is_underutilized],
  filter[is_overcommitted], filter[stranded_resource], and filter[idle_state] parameters.
  Valid values: idle, overcommitted, stranded_cpu, stranded_memory, underutilized, optimized.
  Comma-separated values are ORed.

  Other filters: instance_type, machineset_name, term, engine.

  Response fields: pod_capacity, pod_scheduling_headroom, machineset_name, suggested_instance_type,
  instance_type_reason (when stranded and another instance type exists in the cluster).
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
