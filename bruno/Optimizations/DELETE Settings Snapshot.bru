meta {
  name: DELETE Settings Snapshot
  type: http
  seq: 41
}

delete {
  url: {{baseURL}}/recommendations/openshift/settings/snapshot
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Removes per-org snapshot settings overrides (reverts to env defaults).
  Expect **204 No Content** on success.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 204
}
