meta {
  name: ResourceQuota recommendations - CSV export
  type: http
  seq: 34
}

get {
  url: {{baseURL}}/recommendations/openshift/quota?format=csv&limit=100&offset=0&order_by=namespace&order_how=asc
  body: none
  auth: inherit
}

params:query {
  format: csv
  limit: 100
  offset: 0
  order_by: namespace
  order_how: asc
}

headers {
  Accept: text/csv
  x-rh-identity: {{xRhIdentity}}
}

docs {
  CSV export for namespace ResourceQuota recommendations.

  - `format=csv` returns `text/csv` with list columns (see OpenAPI).
  - Prefer `Accept: text/csv` for explicit content negotiation.
  - Same filters as JSON list (`filter[cluster]`, `filter[project]`, `filter[tag:key]`, etc.).
}

settings {
  encodeUrl: true
  timeout: 0
}
