meta {
  name: Container notification codes
  type: http
  seq: 68
}

get {
  url: {{baseURL}}/recommendations/openshift/notification-codes?filter[plugin]=container
  body: none
  auth: none
}

params:query {
  filter[plugin]: container
}

docs {
  Notification code catalog for container right-sizing recommendations.

  filter[plugin]=container returns codes: 1, 2, 3, 5, 6, 7, 8, 9, 21, 22, 25.

  Common codes:
    1  — INFO (general)
    2  — STALE_DATA
    3  — LOW_CONFIDENCE
    5  — MEMORY_TREND
    6  — OOM_DETECTED
    7  — CPU_SPIKE
    21 — IDLE_WORKLOAD
    22 — ZOMBIE_WORKLOAD
    25 — NO_COST_DATA

  No auth required. Omit filter[plugin] for the full sorted catalog.
}

settings {
  encodeUrl: true
  timeout: 0
}
