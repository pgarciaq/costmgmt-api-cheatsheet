meta {
  name: Container notification codes
  type: http
  seq: 68
}

get {
  url: {{baseURL}}/recommendations/openshift/notification-codes?filter[plugin]=container
  body: none
  auth: none
}

params:query {
  filter[plugin]: container
}

docs {
  Notification code catalog for container right-sizing recommendations.

  filter[plugin]=container returns codes: 1, 2, 3, 5, 6, 7, 8, 9, 21, 22, 25, 77.

  Common codes (name — severity):
    1  — LOW_CONFIDENCE (WARNING)
    2  — STALE_DATA (WARNING)
    3  — OOM_DETECTED (CRITICAL)
    5  — IDLE_WORKLOAD (INFO)
    6  — RECOMMENDATION_APPLIED (INFO)
    7  — NEW_WORKLOAD (INFO)
    8  — ABANDONED_WORKLOAD (WARNING)
    9  — MEMORY_TRENDING_UP (WARNING)
    21 — HPA_SATURATED (WARNING, reserved — not emitted)
    22 — HPA_ACTIVE (INFO, reserved — not emitted)
    25 — NO_COST_DATA (INFO)
    77 — SPARSE_DATA (INFO)

  No auth required. Omit filter[plugin] for the full sorted catalog.
}

settings {
  encodeUrl: true
  timeout: 0
}
