meta {
  name: Node utilization - filter zombie
  type: http
  seq: 8.2
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?filter[idle_state]=zombie
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Near-empty nodes (very low CPU P95 and few pods). Often paired with notification code 15.
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
