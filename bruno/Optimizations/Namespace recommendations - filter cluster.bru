meta {
  name: Namespace recommendations - filter cluster
  type: http
  seq: 9
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?filter[cluster]={{cluster}}&limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  ~filter[cluster]: {{cluster}}
  limit: 20
  offset: 0
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Filter by cluster alias or UUID. Legacy flat param `?cluster=` is also accepted.
}

settings {
  encodeUrl: true
  timeout: 0
}
