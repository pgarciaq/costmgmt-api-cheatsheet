meta {
  name: Quota recommendations
  type: http
  seq: 10
}

get {
  url: {{baseURL}}/recommendations/openshift/quota?filter[recommendation_type]=tighten&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Namespace ResourceQuota list. See Quota recommendations detail/filters Bruno files for detail, order_by, and settings.
  Requires ROS_ENABLED_PLUGINS quota.
}

settings {
  encodeUrl: true
  timeout: 0
}
