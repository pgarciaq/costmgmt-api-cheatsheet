meta {
  name: Node recommendations - savings shape
  type: http
  seq: 70
}

get {
  url: {{baseURL}}/recommendations/openshift/nodes?limit=5
  body: none
  auth: inherit
}

params:query {
  limit: 5
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Per-engine savings live under nested terms, not at the list row top level:

  `.data[0].recommendation_terms.medium_term.recommendation_engines.cost.estimated_monthly_savings`

  Detail (`GET /nodes/{node}`) uses the same `recommendation_terms` shape plus optional
  top-level aggregated `notifications`. Negative `estimated_monthly_savings.value` is valid
  (upsize / additional monthly cost).
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
