meta {
  name: GET Settings Thresholds - Node
  type: http
  seq: 22
}

get {
  url: {{baseURL}}/recommendations/openshift/settings/node
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Canonical node plugin thresholds (alias: GET .../settings/thresholds?recommendation_type=node).

  Response includes locked_fields, settings_locked, and tunables such as:
  underutil_threshold, overcommit_threshold, cost_target_utilization,
  perf_target_utilization, stranded_imbalance_threshold, pod_headroom_* gates,
  zombie/idle classification thresholds.

  RBAC: same as other settings endpoints (org admin / cost-management settings access).
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.cost_target_utilization: isNumber
}
