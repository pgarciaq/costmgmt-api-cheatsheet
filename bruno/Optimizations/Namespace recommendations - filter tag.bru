meta {
  name: Namespace recommendations - filter tag
  type: http
  seq: 21
}

get {
  url: {{baseURL}}/recommendations/openshift/namespaces?filter[tag:environment]=production&limit=20
  body: none
  auth: inherit
}

params:query {
  filter[tag:environment]: production
  limit: 20
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Tag filter on namespace list (requires ROS_TAGS_ENABLED=true).

  Syntax (same as containers):
    filter[tag:<key>]=<value>
    filter[tag:<key>]=a,b
    filter[tag:<key>]=*
}

settings {
  encodeUrl: true
  timeout: 0
}

assert {
  res.status: eq 200
  res.body.meta.count: isNumber
  res.body.data: isArray
}
