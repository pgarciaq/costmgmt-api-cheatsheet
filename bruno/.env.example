## For consoledot (prod environment), use your service account credentials from console.redhat.com
## For on-prem (onprem environment), use the cost-management-operator client from Keycloak:
##   oc get secret keycloak-client-secret-cost-management-operator -n keycloak -o jsonpath='{.data.CLIENT_ID}' | base64 -d
##   oc get secret keycloak-client-secret-cost-management-operator -n keycloak -o jsonpath='{.data.CLIENT_SECRET}' | base64 -d
CLIENT_ID=replaceme
CLIENT_SECRET=replaceme

## Optional: base64-encoded x-rh-identity JSON for Bruno requests that send the header (ROS optimizations).
## Also set the matching `xRhIdentity` variable on the active Bruno environment when testing without gateway injection.
# X_RH_IDENTITY=
