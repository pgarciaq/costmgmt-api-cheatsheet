meta {
  name: GPU MIG profiles
  type: http
  seq: 17
}

get {
  url: {{baseURL}}/reports/openshift/gpu/mig_profiles/?filter[time_scope_units]=month&filter[time_scope_value]=-1&filter[resolution]=monthly&filter[gpu_vendor]=nvidia&filter[gpu_model]=A100&filter[node]=gpu_node_0&group_by[mig_profile]=*
  body: none
  auth: inherit
}

params:query {
  filter[time_scope_units]: month
  filter[time_scope_value]: -1
  filter[resolution]: monthly
  filter[gpu_vendor]: nvidia
  filter[gpu_model]: A100
  filter[node]: gpu_node_0
  group_by[mig_profile]: *
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Requires filter[gpu_vendor], filter[gpu_model], and filter[node].
  group_by[mig_profile] is optional; the endpoint defaults to grouping by mig_profile when omitted.
}
