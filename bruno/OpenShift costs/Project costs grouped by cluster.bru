meta {
  name: Project costs grouped by cluster
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/reports/openshift/costs/?filter[time_scope_units]=month&filter[time_scope_value]=-1&filter[resolution]=monthly&group_by[cluster]=*&group_by[project]=*
  body: none
  auth: inherit
}

params:query {
  filter[time_scope_units]: month
  filter[time_scope_value]: -1
  filter[resolution]: monthly
  group_by[cluster]: *
  group_by[project]: *
}

settings {
  encodeUrl: true
  timeout: 0
}
