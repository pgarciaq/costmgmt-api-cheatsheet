meta {
  name: Per AWS EC2 Fedora VM
  type: http
  seq: 5
}

get {
  url: https://console.redhat.com/api/cost-management/v1/reports/aws/resources/ec2-compute/?cost_type=calculated_amortized_cost&currency=USD&filter[operating_system]=Fedora&filter[resolution]=monthly&filter[time_scope_units]=month&filter[time_scope_value]=-1&limit=10&offset=0&order_by[cost]=desc
  body: none
  auth: inherit
}

params:query {
  cost_type: calculated_amortized_cost
  currency: USD
  filter[operating_system]: Fedora
  filter[resolution]: monthly
  filter[time_scope_units]: month
  filter[time_scope_value]: -1
  limit: 10
  offset: 0
  order_by[cost]: desc
}

settings {
  encodeUrl: true
  timeout: 0
}
